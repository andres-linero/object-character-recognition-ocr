# Fill with your own resources. Never commit .env.
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
EXCEL_PATH=examples/orders.xlsx
# Optional override; default is the repository Scans/incoming_scans directory.
SCAN_PDF_PATH=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8501
USE_AZURE_KEYVAULT=0
AZURE_KEY_VAULT_URL=
# Optional form-specific strings and numbers to ignore:
OCR_HEADER_NOISE=
OCR_EXCLUDED_NUMBERS=

# Optional relational store. Blank retains legacy Excel reads.
# Example: postgresql+psycopg://ocr:<password>@127.0.0.1:5432/ocr
DATABASE_URL=
# Used only by compose.yaml when starting local PostgreSQL.
POSTGRES_PASSWORD=

# Legacy ambiguous-number fallback is off; prefer explicit OCR labels.
OCR_ALLOW_UNLABELED_FALLBACK=0
