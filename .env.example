# Fill with your own resources. Never commit .env.
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
# Optional form-specific header strings to ignore, separated by |
OCR_HEADER_NOISE=

# Optional relational store for the ingestion CLI; the web app uses local SQLite.
# Example: postgresql+psycopg://ocr:<password>@127.0.0.1:5432/ocr
DATABASE_URL=
# Used only by compose.yaml when starting local PostgreSQL.
POSTGRES_PASSWORD=

# Optional cost guard: stop a scan after this many billable OCR pages (0 = no limit).
OCR_MAX_PAGES_PER_FILE=0
# Optional, development only: append OCR header text and its parsed result to this
# local JSONL file so cases can be reviewed and promoted into tests/fixtures/ocr_golden.json.
OCR_CAPTURE_PATH=
